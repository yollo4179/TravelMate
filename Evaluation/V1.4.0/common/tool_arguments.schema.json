{
  "search_places": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      },
      "region": {
        "type": [
          "string",
          "null"
        ]
      },
      "city": {
        "type": [
          "string",
          "null"
        ]
      },
      "exclude_place_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "integer"
        }
      },
      "area": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "additionalProperties": false
  },
  "create_plan": {
    "type": "object",
    "required": [
      "place_ids",
      "start_at",
      "end_at",
      "origin",
      "transport"
    ],
    "properties": {
      "place_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "integer"
        }
      },
      "start_at": {
        "type": "string"
      },
      "end_at": {
        "type": "string"
      },
      "origin": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "additionalProperties": false
      },
      "transport": {
        "enum": [
          "WALK",
          "CAR"
        ]
      }
    },
    "additionalProperties": false
  },
  "modify_plan": {
    "type": "object",
    "required": [
      "plan_id",
      "operation"
    ],
    "properties": {
      "plan_id": {
        "type": [
          "string",
          "integer"
        ]
      },
      "operation": {
        "enum": [
          "replace",
          "remove",
          "add",
          "reorder"
        ]
      },
      "target_place_id": {
        "type": "integer"
      },
      "new_place_id": {
        "type": "integer"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "operation": {
              "const": "replace"
            }
          }
        },
        "then": {
          "required": [
            "target_place_id",
            "new_place_id"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "enum": [
                "remove",
                "reorder"
              ]
            }
          }
        },
        "then": {
          "required": [
            "target_place_id"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "const": "add"
            }
          }
        },
        "then": {
          "required": [
            "new_place_id"
          ]
        }
      }
    ],
    "additionalProperties": false
  },
  "ask_clarification": {
    "type": "object",
    "required": [
      "missing"
    ],
    "properties": {
      "missing": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "reference_place",
            "distance_range",
            "walking_range",
            "origin",
            "fitness_level",
            "duration",
            "origin_region",
            "activity_type",
            "residency",
            "local_affiliation",
            "facility_type",
            "excluded_place",
            "era",
            "walking_route",
            "start_at",
            "end_at",
            "target_changeset"
          ]
        }
      }
    },
    "additionalProperties": false
  },
  "recall_memory": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  }
}
