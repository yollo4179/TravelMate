        "maxLength" : 200,
        "pattern" : "\\S"
      }, {
        "type" : "null"
      } ],
      "description" : "선택 필터. 생략 또는 null이면 searchContext 값을 사용한다. 둘 다 없으면 제한 없음."
    },
    "region" : {
      "anyOf" : [ {
        "type" : "string",
        "minLength" : 1,
        "maxLength" : 200,
        "pattern" : "\\S"
      }, {
        "type" : "null"
      } ],
      "description" : "선택 필터. 생략 또는 null이면 searchContext 값을 사용한다. 둘 다 없으면 제한 없음."
    },
    "query" : {
      "type" : "string",
      "minLength" : 1,
      "maxLength" : 2000,
      "pattern" : "\\S",
      "description" : "필수 검색어. 사용자 질문에 맞춰 직접 작성하며 서버가 대신 채우지 않는다."
    },
    "exclude_place_ids" : {
      "anyOf" : [ {
        "type" : "array",
