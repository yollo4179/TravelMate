      "description" : "생략 또는 null이면 searchContext의 area를 사용한다. 둘 다 없으면 반경 제한 없음."
    },
    "city" : {
      "anyOf" : [ {
        "type" : "string",
        "minLength" : 1,
        "maxLength" : 200,
        "pattern" : "\\S"
      }, {
        "type" : "null"
      } ],
      "description" : "선택 필터. 생략 또는 null이면 searchContext 값을 사용한다. 둘 다 없으면 제한 없음."
