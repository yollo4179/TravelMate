        "items" : {
          "type" : "integer",
          "minimum" : 1,
          "maximum" : 9223372036854775807
        }
      }, {
        "type" : "null"
      } ],
      "default" : [ ],
      "description" : "생략 또는 null이면 빈 목록. searchContext의 제외 ID와 합친다."
    },
    "limit" : {
      "type" : "integer",
      "minimum" : 1,
      "maximum" : 20,
      "default" : 10
